# Copia este archivo a ".env" y llena tus datos de Azure SQL Database.
DB_SERVER=tu-servidor.database.windows.net
DB_NAME=gascontrol
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_contraseña_sql

# Cadena larga y aleatoria para firmar las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

PORT=3000
